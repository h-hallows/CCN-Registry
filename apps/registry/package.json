{
  "name": "@h-hallows/registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CCN Registry OS — operator console. Single operator, no public surface.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:copy": "ccn-lint ./app ./components ./content",
    "pretest": "npm run lint:copy",
    "db:deploy": "node ../../scripts/core-script.mjs db/migrate.ts",
    "db:migrate": "node ../../scripts/core-script.mjs db/migrate.ts",
    "db:reset": "node ../../scripts/core-script.mjs db/migrate.ts --reset",
    "db:seed": "node ../../scripts/core-script.mjs db/seed.ts"
  },
  "dependencies": {
    "@h-hallows/core": "git+https://github.com/h-hallows/CCN-core.git#v0.1.11",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
