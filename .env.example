# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PGlite database at .pglite/
# (no server required — used by `npm test` and by `npm run db:seed` out of the box).
#
# PGlite keeps its database in one directory and one process owns it at a time, so stop
# the dev server before `db:reset` or `db:seed`, then start it again.
#
# For a real Postgres 16 locally: `npm run db:up` starts one via Docker, then set:
# DATABASE_URL=postgres://ccn:ccn@localhost:5433/ccn_registry
DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployment  (architecture spec § 7)
# ---------------------------------------------------------------------------
# DATABASE_URL is the POOLED connection the running app uses. Include ?sslmode=require.
# A production build with no DATABASE_URL refuses to start rather than silently falling
# back to the embedded database — see lib/env.ts.
#
# DIRECT_URL is the UNPOOLED connection migrations run over. This is not cosmetic:
# migration 0001 contains CREATE TYPE, CREATE FUNCTION and CREATE TRIGGER statements that
# a pooler in transaction mode (Supabase port 6543, Neon's pooler, any pgbouncer) cannot
# execute. Point it at the direct host, usually port 5432.
DIRECT_URL=

# Comma-separated list of operator emails permitted to request a magic link.
# Nobody can sign in if this is empty.
OPERATOR_EMAILS=operator@example.com

# In development the magic link is printed to the server console instead of emailed.
#
# ON A DEPLOYMENT IT IS NOT, AND NOTHING IN THIS FILE CHANGES THAT. This comment used to
# say the link arrives in the function logs, and that stopped being true when the mail
# module was made to fail closed. A magic link is a bearer credential with a fifteen
# minute life; function logs are read by platform collaborators, log drains and
# aggregators with retention windows nobody is watching. So the console driver resolves
# to 'none' whenever NODE_ENV is production, and MAIL_DRIVER=console does not override
# it. The sign-in form decides whether a mailer is configured BEFORE it looks the address
# up, so with none configured nobody signs in at all — not even you.
#
# Wire one by setting both of these. Resend refuses a domain it has not verified, so
# MAIL_FROM is as necessary as the key.
RESEND_API_KEY=
MAIL_FROM=

# To get in before a domain is verified, mint a link from a machine that can reach the
# database: `npm run operator:link`. README.md, "Getting in before mail is wired".
#
# That script puts an origin in the link it prints. It takes one as its second argument,
# which is what the README shows; set this to stop typing it each time.
CONSOLE_URL=

# ---------------------------------------------------------------------------
# Where the people this console writes to are sent
# ---------------------------------------------------------------------------
# PORTAL_URL is the public site's origin, and it is how a family, a provider or a
# referral partner reaches the screen this console grants them. There is no usable
# default on a deployment: with neither this nor NEXT_PUBLIC_SITE_URL set, a production
# build REFUSES to issue portal access rather than minting a link to localhost. It
# refuses before writing anything, because a grant that succeeds while handing somebody
# an address only they can reach leaves an audit entry saying they were let in on a day
# nobody could have let them in. Locally it still defaults to http://localhost:3003.
PORTAL_URL=

# Read only as the fallback for PORTAL_URL, for a deployment that already sets it for
# another purpose. Setting PORTAL_URL is clearer; this is here so that a deployment with
# only this one does not refuse for no reason an operator can see.
NEXT_PUBLIC_SITE_URL=
