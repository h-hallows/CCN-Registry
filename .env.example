# Leave DATABASE_URL unset to use the embedded PGlite database at .pglite/
# (no server required — used by `npm test` and by `npm run db:seed` out of the box).
#
# For a real Postgres 16: `npm run db:up` starts one via Docker, then set:
# DATABASE_URL=postgres://ccn:ccn@localhost:5433/ccn_registry
DATABASE_URL=

# Session cookie signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Comma-separated list of operator emails permitted to request a magic link.
OPERATOR_EMAILS=operator@example.com

# In development the magic link is printed to the server console instead of emailed.
