{
  "name": "ccn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CCN workspaces. packages/core is the library both apps consume; apps/* are the deployables.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ccn/registry",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@ccn/registry",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint:copy": "npm run lint:copy --workspaces --if-present",
    "ci": "npm run lint:copy && npm run typecheck && npm run test",
    "db:deploy": "npm run db:deploy --workspace=@ccn/core",
    "db:migrate": "npm run db:migrate --workspace=@ccn/core",
    "db:reset": "npm run db:reset --workspace=@ccn/core",
    "db:seed": "npm run db:seed --workspace=@ccn/core",
    "db:up": "docker compose up -d && node scripts/wait-for-pg.mjs",
    "db:down": "docker compose down",
    "dev:web": "npm run dev --workspace=@ccn/web",
    "build:registry": "npm run build --workspace=@ccn/registry",
    "build:web": "npm run build --workspace=@ccn/web"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
